    "dists = {\n",
    "    'clf__n_estimators': randint(100, 500),\n",
    "    'clf__max_depth': randint(3, 15),\n",
    "    'clf__min_samples_leaf': randint(1, 10),\n",
    "    'clf__max_features': ['sqrt', 'log2', None],\n",
    "}\n",
    "search = RandomizedSearchCV(rf_pipe, dists, n_iter=20, cv=cv, scoring='accuracy',\n",
